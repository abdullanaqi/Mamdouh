# ============================================================================
# Crewline environment variables
# Copy to `.env` and fill in. Every variable the code reads is listed here.
# Variables marked (MVP) are used by Phases 0-3. Variables marked (deferred)
# are scaffolded interfaces only — Phases 4-5, not implemented in the MVP.
# ============================================================================

# --- Core (MVP) ---
# Postgres connection string. For local dev with the bundled script use e.g.
#   postgresql://postgres@127.0.0.1:5433/crewline
DATABASE_URL=
# Public base URL of the app (used in emails/links). e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth / session (MVP) ---
# Secret used to sign session JWTs (HS256). Generate with: openssl rand -hex 32
# In the MVP, auth is a self-contained session layer (see README "Auth").
AUTH_SECRET=

# --- Anthropic (MVP) ---
# Required for live AI features. Without it, AI calls fail fast with a clear
# error; tests inject a fake client and do NOT need this key.
ANTHROPIC_API_KEY=

# --- Storage (MVP) ---
# Driver for proof photos: "local" (writes under .local-storage, for dev) or
# "r2" (Cloudflare R2 / S3-compatible, for prod).
STORAGE_DRIVER=local
# Required only when STORAGE_DRIVER=r2:
STORAGE_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Email (MVP) ---
# Driver: "log" (records outbound email to the messages table + console, dev)
# or "resend" (sends via Resend, prod). Sending real email is a HANDBACK item.
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM=

# --- Maps / geocoding (MVP) ---
# Driver: "manual" (owner enters lat/lng; no external call, dev default) or
# "google" (geocode address via Google Maps Platform, needs key).
GEOCODE_DRIVER=manual
GOOGLE_MAPS_API_KEY=

# --- Background jobs (MVP) ---
# Shared secret required in the `x-cron-secret` header to invoke /api/cron/*
# endpoints (recurring shift materialization, nightly photo scan, reminders).
CRON_SECRET=

# --- Observability (MVP, optional) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ============================================================================
# DEFERRED — Phase 4 (v1.1): Twilio SMS/Voice + crew OTP hardening.
# Interfaces are scaffolded in lib/integrations/twilio but NOT implemented.
# ============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

# ============================================================================
# DEFERRED — Phase 5 (v1.2): Stripe Connect embedded payments (Act II).
# Interfaces are scaffolded in lib/integrations/stripe but NOT implemented.
# ============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
