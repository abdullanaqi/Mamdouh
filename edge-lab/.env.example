# ==== Massive.com flat files (S3-compatible) ====
# Create these in your Massive dashboard. NEVER commit the real .env file.
MASSIVE_ACCESS_KEY_ID=your-access-key-id-here
MASSIVE_SECRET_ACCESS_KEY=your-secret-access-key-here
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# ==== Massive REST/WebSocket API (only needed for LIVE same-day picks) ====
# Verify the base URL in your Massive API docs before using.
MASSIVE_API_BASE=https://api.massive.com
MASSIVE_API_KEY=your-massive-api-key-here

# ==== Account sizing ====
ACCOUNT_EQUITY=10000

# ==== Optional: LLM research advisor (idea generation & audits only) ====
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
